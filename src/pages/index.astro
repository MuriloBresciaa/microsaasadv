      <!-- Messages Area -->
      <div id="concierge-chat-area" class="flex-1 p-6 overflow-y-auto space-y-4 max-h-[300px] min-h-[250px] bg-slate-50/30">
        <!-- Initial Assistant Message -->
        <div class="flex items-start gap-2.5">
          <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200/40 text-[9px] font-bold text-slate-700 shrink-0">AI</div>
          <div class="bg-white border border-slate-200/40 rounded-2xl rounded-tl-none p-3.5 shadow-xs max-w-[85%]">
