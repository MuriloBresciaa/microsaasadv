          placeholder="Escreva sua dúvida..." 
          class="flex-1 bg-white border border-slate-200/60 rounded-full px-4 py-2 text-xs font-apple-text text-primary focus:outline-hidden focus:border-slate-400 transition-colors"
        />
        <button 
          id="concierge-send" 
          class="w-8 h-8 rounded-full bg-primary text-white flex items-center justify-center hover:bg-slate-800 transition-colors shadow-xs active:scale-95 shrink-0 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Trigger Button -->
    <button 
      id="concierge-trigger" 
      data-magnetic
      class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full apple-glass-card flex items-center justify-center shadow-lg cursor-pointer hover:shadow-xl active:scale-95 group border border-slate-200/80"
      aria-label="Falar com o assistente"
    >
      <!-- Active Notification Badge -->
      <span class="absolute top-0 right-0 w-3 h-3 bg-accent rounded-full border border-white apple-online-pulse"></span>
      <!-- Laser line icon -->
      <svg class="w-5 h-5 text-primary transition-transform duration-300 group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
    </button>
  </main>
</RootLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // 0. Animação de Entrada GSAP para Elementos do Hero
    const tlHero = gsap.timeline({ defaults: { ease: "power3.out" } });
    tlHero.from('[data-anim="hero-tag"]', { opacity: 0, y: 15, duration: 0.6 })
          .from('[data-anim="hero-title"]', { opacity: 0, y: 25, duration: 0.8 }, "-=0.4")
          .from('[data-anim="hero-sub"]', { opacity: 0, y: 15, duration: 0.6 }, "-=0.5")
          .from('[data-anim="hero-cta"]', { opacity: 0, scale: 0.96, duration: 0.5 }, "-=0.4");

    // 1. Motor de Coordenadas de Luz Traseira Hero
    const trigger = document.getElementById("hero-trigger");
    const backlight = document.getElementById("hero-backlight");

    if (trigger && backlight) {
      trigger.addEventListener("mousemove", (e) => {
        const rect = trigger.getBoundingClientRect();
        const x = e.clientX - rect.left - 300;
        const y = e.clientY - rect.top - 300;
        gsap.to(backlight, { x: x, y: y, duration: 1.2, ease: "power2.out" });
      });
    }

    // 2. Efeito de Scroll: Capsule Navbar Shifting (Mobile & Desktop)
    const header = document.getElementById("main-header");
    if (header) {
      window.addEventListener("scroll", () => {
        if (window.scrollY > 40) {
          header.classList.add("shadow-lg", "border-slate-300/80", "bg-[#F9F9FB]/95");
          gsap.to(header, { scale: 0.95, duration: 0.3, ease: "power2.out" });
        } else {
          header.classList.remove("shadow-lg", "border-slate-300/80", "bg-[#F9F9FB]/95");
          gsap.to(header, { scale: 1, duration: 0.3, ease: "power2.out" });
        }
      });
    }

    // 2.5. Efeito de Scroll: Revelação Suave das Prateleiras de Governança
    gsap.utils.toArray(".governanca-shelf").forEach(shelf => {
      gsap.fromTo(shelf,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 1.0,
          ease: "power2.out",
          scrollTrigger: {
            trigger: shelf,
            start: "top 85%",
            toggleActions: "play none none none"
          }
        }
      );
    });

    // 3. Efeito de Scroll: Proximity Focus Text (Foco Dinâmico de Linha)
    gsap.utils.toArray(".apple-proximity-text").forEach(text => {
      gsap.fromTo(text,
        { opacity: 0.35, y: 5 },
        {
          opacity: 1,
          y: 0,
          scrollTrigger: {
            trigger: text,
            start: "top 85%",
            end: "top 50%",
            scrub: true
          }
        }
      );
    });

    // 4. Efeito de Scroll: Laser Icon Parallax Assíncrono
    gsap.utils.toArray(".laser-icon-wrapper").forEach(icon => {
      gsap.to(icon, {
        yPercent: -25,
        ease: "none",
        scrollTrigger: {
          trigger: icon,
          start: "top bottom",
          end: "bottom top",
          scrub: true
        }
      });
    });

    // 5. Animação de Scroll-Driven Metallic Sheen Separada por Título
    gsap.utils.toArray(".apple-text-sheen").forEach(title => {
      gsap.fromTo(title, 
        { backgroundPosition: "200% center" },
        {
          backgroundPosition: "0% center",
          scrollTrigger: {
            trigger: title,
            start: "top 85%",
            end: "bottom 15%",
            scrub: 1.2
          }
        }
      );
    });

    // 6. Expansão Controlada do Cinema Video Box
    const videoCard = document.querySelector(".apple-video-hardware-card");
    if (videoCard) {
      gsap.fromTo(videoCard,
        { scale: 0.96 },
        {
          scale: 1.02,
          scrollTrigger: {
            trigger: "#video-reveal-container",
            start: "top 90%",
            end: "bottom 30%",
            scrub: 1
          }
        }
      );
    }

    // 7. Efeito de Botão Magnético de Alta Fidelidade (Cinematic Builder §3.3)
    document.querySelectorAll('[data-magnetic]').forEach(btn => {
      btn.addEventListener('mousemove', e => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(btn, {
          x: x * 0.3,
          y: y * 0.3,
          scale: 1.02,
          duration: 0.4,
          ease: 'power2.out'
        });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, scale: 1, duration: 0.5, ease: 'elastic.out(1, 0.5)' });
      });
    });

    // 8. Seleção Interativa de Engines com Feedback Táctil
    const engineCards = document.querySelectorAll(".interactive-engine-card");
    engineCards.forEach(card => {
      card.addEventListener("click", () => {
        engineCards.forEach(c => c.classList.remove("active"));
        card.classList.add("active");
        
        // Micro-interação de ressalto
        gsap.fromTo(card,
          { scale: 0.98 },
          { scale: 1, duration: 0.4, ease: "back.out(1.7)" }
        );
      });
    });

    // 9. Interceptação de links de CTA com Animação Cinematográfica GSAP
    document.querySelectorAll('.cta-link').forEach(link => {
      link.addEventListener('click', e => {
        e.preventDefault();
        const destination = link.getAttribute('href');

        gsap.to("#main-content", {
          opacity: 0,
          scale: 0.98,
          duration: 0.5,
          ease: "power2.inOut",
          onComplete: () => {
            window.location.href = destination;
          }
        });
        
        // Suavizar encolhimento do Header junto
        gsap.to("#main-header", {
          opacity: 0,
          y: -20,
          duration: 0.4,
          ease: "power2.inOut"
        });
      });
    });

    // 10. Lógica de Interação e Simulação do Assistente Virtual Premium (Concierge Card)
    const conciergeTrigger = document.getElementById("concierge-trigger");
    const conciergePanel = document.getElementById("concierge-panel");
    const conciergeClose = document.getElementById("concierge-close");
    const conciergeInput = document.getElementById("concierge-input");
    const conciergeSend = document.getElementById("concierge-send");
    const conciergeChatArea = document.getElementById("concierge-chat-area");

    let isConciergeOpen = false;

    function openConcierge() {
      isConciergeOpen = true;
      conciergePanel.classList.remove("hidden");
      
      // Esconder a pulsação de notificação do trigger quando aberto
      const badge = conciergeTrigger.querySelector(".apple-online-pulse");
      if (badge) {
        gsap.to(badge, { opacity: 0, scale: 0, duration: 0.3 });
      }

      gsap.fromTo(conciergePanel,
        { scale: 0.9, opacity: 0 },
        { scale: 1, opacity: 1, duration: 0.5, ease: "back.out(1.5)" }
      );
      
      setTimeout(() => {
        conciergeChatArea.scrollTop = conciergeChatArea.scrollHeight;
      }, 100);
    }

    function closeConcierge() {
      isConciergeOpen = false;
      gsap.to(conciergePanel, {
        scale: 0.9,
        opacity: 0,
        duration: 0.3,
        ease: "power2.in",
        onComplete: () => {
          conciergePanel.classList.add("hidden");
        }
      });
    }

    if (conciergeTrigger && conciergePanel && conciergeClose) {
      conciergeTrigger.addEventListener("click", (e) => {
        e.stopPropagation();
        if (isConciergeOpen) {
          closeConcierge();
        } else {
          openConcierge();
        }
      });

      conciergeClose.addEventListener("click", (e) => {
        e.stopPropagation();
        closeConcierge();
      });

      // Fechar ao clicar fora
      document.addEventListener("click", (e) => {
        if (isConciergeOpen && !conciergePanel.contains(e.target) && !conciergeTrigger.contains(e.target)) {
          closeConcierge();
        }
      });

      // Fechar com a tecla Esc
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isConciergeOpen) {
          closeConcierge();
        }
      });
    }

    // Simulador de Conversa
    function appendMessage(sender, text) {
      if (!conciergeChatArea) return;
      const msgDiv = document.createElement("div");
      msgDiv.className = "flex items-start gap-2.5 " + (sender === "user" ? "justify-end" : "");
      
      const iconOrNone = sender === "user" 
        ? "" 
        : `<div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200/40 text-[9px] font-bold text-slate-700 shrink-0">AI</div>`;
        
      const bgAndStyle = sender === "user"
        ? "bg-primary text-white rounded-2xl rounded-tr-none p-3.5 shadow-xs max-w-[85%]"
        : "bg-white border border-slate-200/40 rounded-2xl rounded-tl-none p-3.5 shadow-xs max-w-[85%]";

      const textStyle = sender === "user"
        ? "font-apple-text text-[11px] leading-relaxed font-normal"
        : "font-apple-text text-[11px] text-slate-800 leading-relaxed font-normal";

      msgDiv.innerHTML = `
        ${iconOrNone}
        <div class="${bgAndStyle}">
          <p class="${textStyle}">${text}</p>
        </div>
      `;
      
      conciergeChatArea.appendChild(msgDiv);
      conciergeChatArea.scrollTop = conciergeChatArea.scrollHeight;
      
      // Animação GSAP de entrada da mensagem
      gsap.from(msgDiv, { opacity: 0, y: 10, duration: 0.3, ease: "power2.out" });
    }

    function showTypingIndicator() {
      if (!conciergeChatArea) return;
      const indicatorDiv = document.createElement("div");
      indicatorDiv.id = "concierge-typing-indicator";
      indicatorDiv.className = "flex items-start gap-2.5";
      indicatorDiv.innerHTML = `
        <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200/40 text-[9px] font-bold text-slate-700 shrink-0">AI</div>
        <div class="bg-white border border-slate-200/40 rounded-2xl rounded-tl-none px-4 py-3.5 shadow-xs max-w-[85%] flex items-center gap-1">
          <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0ms"></span>
          <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 150ms"></span>
          <span class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 300ms"></span>
        </div>
      `;
      conciergeChatArea.appendChild(indicatorDiv);
      conciergeChatArea.scrollTop = conciergeChatArea.scrollHeight;
    }

    function removeTypingIndicator() {
      const indicator = document.getElementById("concierge-typing-indicator");
      if (indicator) {
        indicator.remove();
      }
    }

    const presetResponses = {
      "como funciona o teste de 7 dias": "O teste é 100% gratuito por 7 dias. Não exigimos cartão de crédito na ativação. Você terá acesso total às 3 engines (Contratos, Petições e Provas) com limites amplos para testar com casos reais. A qualquer momento, você pode migrar para a assinatura ou cancelar sem taxas.",
      "a ia atende as normas da oab": "Sim. O JurisAI foi desenvolvido em conformidade estrita com o Estatuto da Advocacia e o Código de Ética da OAB. A IA funciona como uma ferramenta auxiliar de co-piloto; a responsabilidade técnica e assinatura final dos documentos continuam sendo exclusivas do advogado.",
      "posso auditar contratos em lote": "Sim! Pelo painel corporativo (Dashboard), você pode fazer o upload de múltiplos arquivos em lote. O sistema processa cada minuta de forma isolada, gerando um relatório consolidado com matriz de riscos graves, médios e cláusulas recomendadas."
    };

    function handleUserMessage(messageText) {
      if (!messageText.trim()) return;
      appendMessage("user", messageText);
      
      // Mostrar indicador de digitação após delay suave
      setTimeout(() => {
        showTypingIndicator();
      }, 400);

      // Limpar acentos para busca de resposta
      const normalizedMsg = messageText.trim().toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[?.]/g, "");
      
      let reply = "Entendido. Um de nossos especialistas em tecnologia jurídica entrará em contato para detalhar esse fluxo. Se desejar testar imediatamente, basta clicar no botão 'Iniciar Teste Sem Cartão' logo abaixo!";
      
      for (const key in presetResponses) {
        if (normalizedMsg.includes(key) || key.includes(normalizedMsg)) {
          reply = presetResponses[key];
          break;
        }
      }

      setTimeout(() => {
        removeTypingIndicator();
        appendMessage("ai", reply);
      }, 1600);
    }

    // Configurar Chips de Sugestão
    document.querySelectorAll(".suggestion-chip").forEach(chip => {
      chip.addEventListener("click", (e) => {
        e.stopPropagation();
        const question = chip.innerText.trim();
        const suggestionsDiv = document.getElementById("concierge-suggestions");
        if (suggestionsDiv) {
          gsap.to(suggestionsDiv, { 
            opacity: 0, 
            height: 0, 
            duration: 0.3, 
            onComplete: () => suggestionsDiv.remove() 
          });
        }
        handleUserMessage(question);
      });
    });

    // Enviar mensagem via botão ou enter
    if (conciergeSend && conciergeInput) {
      conciergeSend.addEventListener("click", () => {
        const text = conciergeInput.value;
        if (text.trim()) {
          conciergeInput.value = "";
          const suggestionsDiv = document.getElementById("concierge-suggestions");
          if (suggestionsDiv) suggestionsDiv.remove();
          handleUserMessage(text);
        }
      });

      conciergeInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          const text = conciergeInput.value;
          if (text.trim()) {
            conciergeInput.value = "";
            const suggestionsDiv = document.getElementById("concierge-suggestions");
            if (suggestionsDiv) suggestionsDiv.remove();
            handleUserMessage(text);
          }
        }
      });
    }
  });
</script>
