---
import RootLayout from '@/layouts/RootLayout.astro';
---

<RootLayout title="Site Factory V2.0 | Template Base">
  <main class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-6">
    <!-- Background Grid Pattern -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background-image: linear-gradient(var(--color-border-subtle) 1px, transparent 1px), linear-gradient(90deg, var(--color-border-subtle) 1px, transparent 1px); background-size: 64px 64px;"
      aria-hidden="true"
    ></div>

    <!-- Radial Glow -->
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] rounded-full opacity-20"
      style="background: radial-gradient(circle, hsl(192, 100%, 48%) 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <!-- Hero Content -->
    <section class="relative z-10 flex max-w-3xl flex-col items-center text-center">
      <!-- Badge -->
      <div
        class="mb-8 inline-flex items-center gap-2 rounded-full border border-[var(--color-border-strong)] bg-[var(--color-bg-surface)] px-4 py-1.5 text-xs font-medium tracking-wider uppercase text-[var(--color-text-secondary)]"
      >
        <span
          class="inline-block h-2 w-2 rounded-full bg-[var(--color-accent-400)]"
          style="box-shadow: 0 0 8px hsl(142, 90%, 55% / 0.6);"
        ></span>
        Sistema Operacional
      </div>

      <!-- Heading -->
      <h1
        class="text-5xl font-extrabold leading-[1.1] tracking-tight sm:text-6xl lg:text-7xl"
      >
        <span class="text-gradient-primary">Site Factory</span>
        <br />
        <span class="text-[var(--color-text-primary)]">V2.0 Ativo</span>
      </h1>

      <!-- Subheading -->
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-[var(--color-text-secondary)]">
        Template base para landing pages de alta conversão e e-commerces ultra-rápidos.
        Astro &bull; React &bull; Tailwind &bull; Supabase.
      </p>

      <!-- CTA -->
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row">
        <a
          href="#docs"
          class="glow-md inline-flex items-center justify-center rounded-lg bg-[var(--color-primary-500)] px-8 py-3.5 text-sm font-semibold text-[var(--color-text-inverted)] transition-all duration-200 hover:bg-[var(--color-primary-400)] hover:glow-lg"
        >
          Ver Documentação
        </a>
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-bg-surface)] px-8 py-3.5 text-sm font-semibold text-[var(--color-text-primary)] transition-all duration-200 hover:border-[var(--color-primary-500)] hover:text-[var(--color-primary-400)]"
        >
          GitHub →
        </a>
      </div>

      <!-- Tech Stack Badges -->
      <div class="mt-16 flex flex-wrap items-center justify-center gap-3">
        {['Astro 6', 'React 19', 'Tailwind v4', 'Framer Motion', 'Supabase', 'Nano Stores'].map(tech => (
          <span
            class="rounded-md border border-[var(--color-border-default)] bg-[var(--color-bg-raised)] px-3 py-1.5 text-xs font-medium text-[var(--color-text-muted)] transition-colors duration-200 hover:border-[var(--color-primary-600)] hover:text-[var(--color-primary-400)]"
          >
            {tech}
          </span>
        ))}
      </div>
    </section>

    <!-- Footer Signature -->
    <footer class="absolute bottom-8 text-xs text-[var(--color-text-muted)]">
      Construído com precisão industrial &mdash; Site Factory V2.0
    </footer>
  </main>
</RootLayout>
