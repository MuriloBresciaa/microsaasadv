          <a href="/app/auth" data-magnetic class="cta-link w-full bg-primary text-white font-semibold text-xs min-h-[48px] flex items-center justify-center rounded-full apple-pill hover:bg-slate-800 transition-colors shadow-xs font-apple-text">
