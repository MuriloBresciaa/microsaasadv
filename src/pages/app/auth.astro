---
export const prerender = false;
import RootLayout from "../../layouts/RootLayout.astro";

// Gera o state de segurança no servidor para proteção CSRF e define o cookie seguro
const state = Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
Astro.cookies.set('oauth_state', state, {
  path: '/',
  secure: true,
  httpOnly: true,
  maxAge: 60 * 10, // 10 minutos
  sameSite: 'lax'
});
---

<RootLayout title="Acessar Plataforma — JurisAI">
  <main class="w-full min-h-screen bg-background flex items-center justify-center p-4 relative overflow-hidden">
    <!-- Luz ambiente traseira de login -->
    <div id="auth-backlight" class="absolute w-[500px] h-[500px] rounded-full bg-radial from-slate-200/50 via-slate-100/10 to-transparent blur-3xl pointer-events-none z-0"></div>

    <div id="auth-card" class="w-full max-w-md bg-white apple-squircle-g2 apple-hardware-card p-8 sm:p-10 z-10 opacity-0 scale-98 isolate">
      
      <!-- Logo e Header Text -->
      <div class="text-center mb-6">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-slate-50 border border-slate-200/60 shadow-xs mb-4">
          <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h1 id="auth-title" class="font-apple-display font-bold text-2xl tracking-tight text-primary mb-2">Bem-vindo ao JurisAI</h1>
        <p id="auth-subtitle" class="font-apple-text text-xs text-secondary leading-relaxed">Digite seu e-mail corporativo para acessar as engines analíticas privadas.</p>
      </div>

      <!-- Tab Switcher -->
      <div class="flex p-1 bg-slate-100 rounded-full mb-8 relative border border-slate-200/40 w-full max-w-[280px] mx-auto">
        <div id="tab-indicator" class="absolute top-1 bottom-1 left-1 bg-white rounded-full shadow-xs border border-slate-200/10 z-0 transition-all duration-300 w-[calc(50%-4px)]"></div>
        <button type="button" id="tab-login" class="flex-1 text-center py-1.5 text-[11px] font-bold font-apple-text text-primary z-10 cursor-pointer relative focus:outline-hidden">
          Iniciar sessão
        </button>
        <button type="button" id="tab-register" class="flex-1 text-center py-1.5 text-[11px] font-bold font-apple-text text-slate-400 z-10 cursor-pointer relative focus:outline-hidden">
          Criar conta
        </button>
      </div>

      <!-- OAuth Social Actions -->
      <div class="grid grid-cols-2 gap-4 mb-5">
        <button type="button" id="oauth-google" data-magnetic class="flex items-center justify-center gap-2 border border-slate-200/80 rounded-full py-2.5 px-4 min-h-[44px] bg-white hover:bg-slate-50 transition-colors shadow-2xs font-apple-text text-xs font-semibold text-primary cursor-pointer">
          <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.24 10.285V14.4h6.887c-.648 2.41-2.519 4.114-5.136 4.114-3.41 0-6.19-2.78-6.19-6.19s2.78-6.19 6.19-6.19c1.7 0 3.25.69 4.39 1.8l3.23-3.23C19.2 2.39 15.93 1 12.24 1 6.04 1 12.24 12.24s5.04 11.24 11.24 11.24c5.89 0 10.9-4.22 10.9-10.9 0-.6-.08-1.2-.2-1.78l-10.7 1.78z"/>
          </svg>
          Google
        </button>
        <button type="button" id="oauth-apple" data-magnetic class="flex items-center justify-center gap-2 border border-slate-200/80 rounded-full py-2.5 px-4 min-h-[44px] bg-white hover:bg-slate-50 transition-colors shadow-2xs font-apple-text text-xs font-semibold text-primary cursor-pointer">
          <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.17c.66-.81 1.11-1.93.99-3.06-.96.04-2.13.64-2.82 1.45-.6.7-1.13 1.84-1 2.94.99.08 2.1-.53 2.83-1.33z"/>
          </svg>
          Apple
        </button>
      </div>

      <!-- Apple Warning (Aviso de Manutenção Liquid Glass) -->
      <div id="apple-warning" class="hidden mb-6 p-4 rounded-2xl bg-amber-50/80 border border-amber-200/50 backdrop-blur-md text-amber-800 font-apple-text text-[11px] leading-relaxed shadow-xs flex items-start gap-2.5">
        <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <span class="font-bold">Acesso Apple Indisponível:</span> ID Apple temporariamente indisponível para manutenção programada. Por favor, utilize o acesso via Google ou o preenchimento por e-mail.
        </div>
      </div>

      <!-- Divider -->
      <div class="relative flex items-center justify-center mb-6">
        <div class="absolute inset-x-0 h-px bg-slate-100"></div>
        <span class="relative px-3 bg-white text-[10px] font-bold text-slate-400 font-apple-text tracking-wider uppercase">ou use seu e-mail</span>
      </div>

      <!-- Credentials Form -->
      <form id="auth-form" data-state={state} class="space-y-4">
        <!-- Dynamic Name Field Wrapper -->
        <div id="name-field-wrapper" class="overflow-hidden" style="height: 0px; opacity: 0;">
          <div class="pb-2">
            <label for="nome" class="block font-apple-text font-semibold text-[11px] text-primary uppercase tracking-wider mb-2">Nome Completo</label>
            <input 
              type="text" 
              id="nome" 
              name="nome" 
              placeholder="Seu nome profissional"
              class="w-full bg-[#F9F9FB] border border-slate-200/80 rounded-xl px-4 py-3 text-sm font-apple-text text-primary placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all shadow-inner"
            />
          </div>
        </div>

        <div>
          <label for="email" class="block font-apple-text font-semibold text-[11px] text-primary uppercase tracking-wider mb-2">E-mail Corporativo</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="exemplo@empresa.com.br"
            class="w-full bg-[#F9F9FB] border border-slate-200/80 rounded-xl px-4 py-3 text-sm font-apple-text text-primary placeholder-slate-400 focus:outline-hidden focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all shadow-inner"
          />
        </div>

        <button 
          type="submit" 
          id="submit-btn"
          data-magnetic 
          class="w-full bg-primary text-white font-semibold text-xs min-h-[44px] flex items-center justify-center rounded-full hover:bg-slate-800 transition-all shadow-xs font-apple-text cursor-pointer mt-6"
        >
          Entrar na Plataforma
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-slate-100 text-center">
        <p class="font-apple-text text-[11px] text-slate-500">Período experimental de 7 dias grátis ativo. Não requer cartão de crédito.</p>
      </div>
    </div>
  </main>
</RootLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. GSAP Entrada da Superfície de Identidade
    gsap.to("#auth-card", {
      opacity: 1,
      scale: 1,
      duration: 0.8,
      ease: "power3.out",
      delay: 0.1
    });

    // 2. Luz Traseira Radial que persegue o cursor
    document.addEventListener("mousemove", (e) => {
      const backlight = document.getElementById("auth-backlight");
      if (backlight) {
        const x = e.clientX - window.innerWidth / 2;
        const y = e.clientY - window.innerHeight / 2;
        gsap.to(backlight, { x: x * 0.4, y: y * 0.4, duration: 1.5, ease: "power2.out" });
      }
    });

    // 3. Efeito de Atração Magnética nos Botões (Google, Apple e Submit)
    document.querySelectorAll('[data-magnetic]').forEach(btn => {
      btn.addEventListener('mousemove', e => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(btn, {
          x: x * 0.25,
          y: y * 0.25,
          duration: 0.4,
          ease: 'power2.out'
        });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.5)' });
      });
    });

    // 4. Mecânica de Alternância por Abas (Iniciar sessão vs Criar conta)
    const tabLogin = document.getElementById("tab-login");
    const tabRegister = document.getElementById("tab-register");
    const tabIndicator = document.getElementById("tab-indicator");
    const nameFieldWrapper = document.getElementById("name-field-wrapper");
    const nomeInput = document.getElementById("nome");
    const authTitle = document.getElementById("auth-title");
    const authSubtitle = document.getElementById("auth-subtitle");
    const submitBtn = document.getElementById("submit-btn");

    let activeTab = "login"; // 'login' | 'register'

    function switchTab(tab) {
      if (activeTab === tab) return;
      activeTab = tab;

      if (tab === "register") {
        tabIndicator.style.left = "calc(50% - 2px)";
        tabLogin.classList.remove("text-primary");
        tabLogin.classList.add("text-slate-400");
        tabRegister.classList.remove("text-slate-400");
        tabRegister.classList.add("text-primary");

        authTitle.innerText = "Criar sua Conta JurisAI";
        authSubtitle.innerText = "Inicie seu teste gratuito de 7 dias preenchendo seus dados profissionais.";
        submitBtn.innerText = "Criar Conta e Iniciar Teste";
        nomeInput.setAttribute("required", "required");

        gsap.to(nameFieldWrapper, {
          height: 82,
          opacity: 1,
          duration: 0.4,
          ease: "power2.out"
        });
      } else {
        tabIndicator.style.left = "4px";
        tabRegister.classList.remove("text-primary");
        tabRegister.classList.add("text-slate-400");
        tabLogin.classList.remove("text-slate-400");
        tabLogin.classList.add("text-primary");

        authTitle.innerText = "Bem-vindo ao JurisAI";
        authSubtitle.innerText = "Digite seu e-mail corporativo para acessar as engines analíticas privadas.";
        submitBtn.innerText = "Entrar na Plataforma";
        nomeInput.removeAttribute("required");

        gsap.to(nameFieldWrapper, {
          height: 0,
          opacity: 0,
          duration: 0.3,
          ease: "power2.in"
        });
      }
    }

    if (tabLogin && tabRegister) {
      tabLogin.addEventListener("click", () => switchTab("login"));
      tabRegister.addEventListener("click", () => switchTab("register"));
    }

    // 5. Integração com os Endpoints de Backend Reais via Redirecionamentos Cinemáticos
    function animateExitAndRedirect(destination) {
      gsap.to("#auth-card", {
        opacity: 0,
        scale: 0.98,
        y: -10,
        duration: 0.5,
        ease: "power3.in",
        onComplete: () => {
          window.location.href = destination;
        }
      });
    }

    document.getElementById("oauth-google").addEventListener("click", () => {
      animateExitAndRedirect("/api/auth/google");
    });

    // 6. Intercepção Apple com Fallback Estético
    document.getElementById("oauth-apple").addEventListener("click", () => {
      const appleWarning = document.getElementById("apple-warning");
      if (appleWarning) {
        if (appleWarning.classList.contains("hidden")) {
          appleWarning.classList.remove("hidden");
          gsap.fromTo(appleWarning, 
            { opacity: 0, scale: 0.95, y: -10 },
            { opacity: 1, scale: 1, y: 0, duration: 0.4, ease: "power2.out" }
          );
        } else {
          gsap.fromTo(appleWarning,
            { scale: 0.98 },
            { scale: 1, duration: 0.3, ease: "elastic.out(1, 0.3)" }
          );
        }
      }

      // Condução óptica com foco no campo de e-mail e pulso luminoso esmeralda
      const emailInput = document.getElementById("email");
      if (emailInput) {
        emailInput.focus();
        gsap.fromTo(emailInput,
          { borderColor: "rgba(229, 231, 235, 1)", boxShadow: "0 0 0 0px rgba(16, 185, 129, 0)" },
          { 
            borderColor: "rgba(16, 185, 129, 1)", 
            boxShadow: "0 0 0 4px rgba(16, 185, 129, 0.2)", 
            duration: 0.3, 
            yoyo: true, 
            repeat: 3, 
            ease: "power2.out",
            onComplete: () => {
              gsap.set(emailInput, { clearProps: "borderColor,boxShadow" });
            }
          }
        );
      }
    });

    // 7. Submissão do formulário de e-mail redirecionando para a simulação de sandbox segura
    const form = document.getElementById("auth-form");
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const currentState = form.getAttribute('data-state');
        animateExitAndRedirect(`/api/auth/callback/google?code=sandbox_code&state=${currentState}`);
      });
    }
  });
</script>
