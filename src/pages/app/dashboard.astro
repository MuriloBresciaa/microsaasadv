<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // ── Animações de Entrada GSAP ──
    gsap.to("#sidebar", {
      opacity: 1,
      x: 0,
      duration: 0.7,
      ease: "power3.out"
    });

    gsap.to("#content", {
      opacity: 1,
      y: 0,
      duration: 0.7,
      ease: "power3.out",
      delay: 0.12
    });

    // ── Stagger dos Cards do Bento Grid ──
    gsap.from("#content article", {
      opacity: 0,
      y: 24,
      duration: 0.6,
      stagger: 0.1,
      ease: "power3.out",
      delay: 0.3
    });

    // ── Laser Icon Parallax Vertical (ScrollTrigger) ──
    if (typeof ScrollTrigger !== "undefined") {
      document.querySelectorAll('[data-parallax-icon]').forEach(icon => {
        gsap.to(icon, {
          y: -8,
          scrollTrigger: {
            trigger: icon.closest("article"),
            start: "top bottom",
            end: "bottom top",
            scrub: 0.6
          }
        });
      });
    }

    // ── Efeito Magnético de Alta Fidelidade (Botões) ──
    document.querySelectorAll('[data-magnetic]').forEach(btn => {
      btn.addEventListener('mousemove', e => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(btn, {
          x: x * 0.2,
          y: y * 0.2,
          duration: 0.4,
          ease: 'power2.out'
        });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.5)' });
      });
    });
  });
</script>
