---
export const prerender = false;
import RootLayout from "../../layouts/RootLayout.astro";
---

<RootLayout title="Analista de Contratos — JurisAI">
  <div class="min-h-screen bg-background flex flex-col md:flex-row p-4 gap-4 relative overflow-hidden">
    
    <!-- Barra Lateral de Navegação (Floating Capsule Sidebar) -->
    <aside id="sidebar" class="w-full md:w-64 bg-white/78 backdrop-blur-xl border border-border rounded-[32px] apple-glass-card p-6 flex flex-col justify-between z-20 shrink-0 opacity-0 -translate-x-4">
      <div class="space-y-8">
        <!-- Logo -->
        <div class="flex items-center gap-2 px-2">
          <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="font-apple-display font-bold tracking-tight text-sm text-primary">JurisAI</span>
        </div>

        <!-- Links de Navegação -->
        <nav class="space-y-2">
          <a href="/app/dashboard" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 text-secondary hover:text-primary text-xs font-semibold font-apple-text transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-3-3v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            Workspace
          </a>
          <a href="/app/analista-contratos" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl bg-primary text-white text-xs font-semibold font-apple-text transition-all shadow-xs">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            Contratos
          </a>
          <a href="/app/copiloto-peticoes" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 text-secondary hover:text-primary text-xs font-semibold font-apple-text transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
            </svg>
            Petições
          </a>
          <a href="/app/auditoria-provas" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 text-secondary hover:text-primary text-xs font-semibold font-apple-text transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Provas
          </a>
        </nav>
      </div>

      <!-- Rodapé da Sidebar -->
      <div class="space-y-4">
        <div class="px-2">
          <p class="font-apple-text text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Advogado Conectado</p>
          <p class="font-apple-text text-xs text-primary truncate">advogado@empresa.com.br</p>
        </div>
        <a href="/app/auth" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl hover:bg-red-50/60 border border-transparent hover:border-red-100 text-red-500 text-xs font-semibold font-apple-text transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sair
        </a>
      </div>
    </aside>

    <!-- Conteúdo Principal -->
    <main id="content" class="flex-1 flex flex-col gap-6 z-10 opacity-0 translate-y-4">
      
      <!-- Cabeçalho do Workspace -->
      <div class="bg-white border border-border rounded-[32px] apple-hardware-card p-6 flex justify-between items-center shadow-sm">
        <div>
          <span class="inline-block text-[9px] font-bold text-accent bg-accent/10 px-2.5 py-1 rounded-full uppercase tracking-wider font-apple-text mb-2">Engine 01</span>
          <h1 class="font-apple-display font-bold text-2xl tracking-[-0.04em] text-primary">Analista de Riscos de Contratos</h1>
        </div>
        <a href="/app/dashboard" class="flex items-center gap-2 text-xs font-semibold text-secondary hover:text-primary transition-colors min-h-[44px] px-3 rounded-full hover:bg-slate-50 font-apple-text">
          ← Voltar
        </a>
      </div>

      <!-- Split View (Duas colunas de igual peso ou balanceadas) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch flex-1">
        
        <!-- Coluna Esquerda: Upload e Configurações de Auditoria -->
        <div class="bg-white border border-border rounded-[32px] apple-hardware-card p-6 sm:p-8 flex flex-col justify-between shadow-sm">
          <div class="space-y-6">
            <h2 class="font-apple-display font-bold text-lg tracking-tight text-primary">Upload de Minutas & Parametrização</h2>
            
            <!-- Dropzone de Arquivos -->
            <div class="border border-dashed border-slate-200 rounded-2xl p-8 text-center bg-slate-50/50 hover:bg-slate-50 hover:border-slate-300 transition-all cursor-pointer">
              <svg class="w-8 h-8 text-slate-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
              </svg>
              <p class="font-apple-text font-semibold text-xs text-primary">Arraste seu arquivo (.pdf ou .docx) ou clique aqui</p>
              <p class="font-apple-text text-[10px] text-slate-400 mt-1">Limite de até 25MB por documento</p>
            </div>

            <!-- Seleção de Critério de Auditoria -->
            <div class="space-y-3">
              <label class="block font-apple-text font-semibold text-[11px] text-primary uppercase tracking-wider">Rigidez da Análise</label>
              <div class="grid grid-cols-3 gap-3">
                <button class="bg-[#F9F9FB] border border-slate-200 rounded-xl py-2.5 px-3 text-xs font-semibold text-secondary hover:text-primary hover:border-slate-300 transition-all font-apple-text text-center">Leve</button>
                <button class="bg-white border-2 border-primary rounded-xl py-2.5 px-3 text-xs font-bold text-primary transition-all font-apple-text text-center shadow-xs">Moderada</button>
                <button class="bg-[#F9F9FB] border border-slate-200 rounded-xl py-2.5 px-3 text-xs font-semibold text-secondary hover:text-primary hover:border-slate-300 transition-all font-apple-text text-center">Extrema</button>
              </div>
            </div>

            <!-- Parâmetros Adicionais -->
            <div class="space-y-3">
              <label class="block font-apple-text font-semibold text-[11px] text-primary uppercase tracking-wider">Jurisprudência de Referência</label>
              <select class="w-full bg-[#F9F9FB] border border-slate-200/80 rounded-xl px-4 py-3 text-xs font-apple-text text-primary focus:outline-hidden focus:ring-2 focus:ring-primary/10">
                <option>Direito Civil Geral (STJ / STF)</option>
                <option>Direito do Consumidor (CDC Aplicado)</option>
                <option>Trabalhista & Previdenciário</option>
              </select>
            </div>
          </div>

          <div class="pt-8">
            <button id="btn-analisar" data-magnetic class="w-full bg-primary text-white font-semibold text-xs min-h-[46px] flex items-center justify-center rounded-full hover:bg-slate-800 transition-all font-apple-text cursor-pointer">
              Executar Auditoria Cognitiva
            </button>
          </div>
        </div>

        <!-- Coluna Direita: Análise de Riscos & Resultados Interativos -->
        <div class="bg-white border border-border rounded-[32px] apple-hardware-card p-6 sm:p-8 flex flex-col justify-between shadow-sm relative overflow-hidden">
          <div class="space-y-6">
            <div class="flex justify-between items-center">
              <h2 class="font-apple-display font-bold text-lg tracking-tight text-primary">Relatório em Tempo Real</h2>
              <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-green-600 bg-green-50 px-2.5 py-1 rounded-full uppercase tracking-wider font-apple-text">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                Engine Pronta
              </span>
            </div>

            <!-- Estado Vazio / Tutorial Inicial -->
            <div id="result-placeholder" class="py-16 text-center space-y-4">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-slate-50 border border-slate-200/40 text-slate-400">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <div class="max-w-xs mx-auto">
                <p class="font-apple-text font-semibold text-xs text-primary">Nenhum contrato auditado</p>
                <p class="font-apple-text text-[11px] text-slate-400 mt-1">Carregue uma minuta na coluna ao lado para extrair o relatório de cláusulas abusivas.</p>
              </div>
            </div>

            <!-- Simulação de Análise de Riscos (Escondido Inicialmente) -->
            <div id="result-data" class="space-y-4 hidden opacity-0">
              <div class="bg-red-50/50 border border-red-100 rounded-2xl p-4 flex gap-4">
                <div class="w-2.5 h-2.5 rounded-full bg-red-500 mt-1.5 shrink-0"></div>
                <div>
                  <h4 class="font-apple-text font-bold text-xs text-red-950">Cláusula 12.4 — Multa Abusiva Violando CDC</h4>
                  <p class="font-apple-text text-[11px] text-red-900 leading-relaxed mt-1">O contrato prevê multa rescisória de 40% sobre o saldo total pendente, violando o princípio da razoabilidade estipulado pelo Código de Defesa do Consumidor.</p>
                </div>
              </div>
              
              <div class="bg-yellow-50/50 border border-yellow-100 rounded-2xl p-4 flex gap-4">
                <div class="w-2.5 h-2.5 rounded-full bg-yellow-500 mt-1.5 shrink-0"></div>
                <div>
                  <h4 class="font-apple-text font-bold text-xs text-yellow-950">Cláusula 19 — Foro de Eleição Conflitante</h4>
                  <p class="font-apple-text text-[11px] text-yellow-900 leading-relaxed mt-1">O foro eleito é de comarca remota que desfavorece desproporcionalmente o polo aderente aderido.</p>
                </div>
              </div>
            </div>
          </div>

          <div id="result-footer" class="pt-8 border-t border-slate-100 hidden opacity-0">
            <button data-magnetic class="w-full bg-[#F9F9FB] border border-slate-200 text-primary font-semibold text-xs min-h-[44px] flex items-center justify-center rounded-full hover:bg-slate-50 transition-all font-apple-text">
              Exportar Relatório PDF
            </button>
          </div>
        </div>

      </div>
    </main>
  </div>
</RootLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Animações de Entrada
    gsap.to("#sidebar", {
      opacity: 1,
      x: 0,
      duration: 0.6,
      ease: "power2.out"
    });

    gsap.to("#content", {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.1
    });

    // Simulação da Análise ao Clicar
    const btnAnalisar = document.getElementById("btn-analisar");
    const placeholder = document.getElementById("result-placeholder");
    const resultData = document.getElementById("result-data");
    const resultFooter = document.getElementById("result-footer");

    if (btnAnalisar && placeholder && resultData) {
      btnAnalisar.addEventListener("click", () => {
        gsap.to(placeholder, {
          opacity: 0,
          y: -10,
          duration: 0.3,
          onComplete: () => {
            placeholder.classList.add("hidden");
            resultData.classList.remove("hidden");
            resultFooter.classList.remove("hidden");
            
            gsap.to(resultData, {
              opacity: 1,
              duration: 0.5,
              ease: "power2.out"
            });
            gsap.to(resultFooter, {
              opacity: 1,
              duration: 0.5,
              ease: "power2.out"
            });
          }
        });
      });
    }

    // Efeito Magnético
    document.querySelectorAll('[data-magnetic]').forEach(btn => {
      btn.addEventListener('mousemove', e => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(btn, {
          x: x * 0.25,
          y: y * 0.25,
          duration: 0.4,
          ease: 'power2.out'
        });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.5)' });
      });
    });
  });
</script>
