---
export const prerender = false;
import RootLayout from "../../layouts/RootLayout.astro";
---

<RootLayout title="Copiloto de Petições — JurisAI">
  <div class="min-h-screen bg-background flex flex-col md:flex-row p-4 gap-4 relative overflow-hidden">
    
    <!-- Barra Lateral de Navegação (Floating Capsule Sidebar) -->
    <aside id="sidebar" class="w-full md:w-64 bg-white/78 backdrop-blur-xl border border-border rounded-[32px] apple-glass-card p-6 flex flex-col justify-between z-20 shrink-0 opacity-0 -translate-x-4">
      <div class="space-y-8">
        <!-- Logo -->
        <div class="flex items-center gap-2 px-2">
          <svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="font-apple-display font-bold tracking-tight text-sm text-primary">JurisAI</span>
        </div>

        <!-- Links de Navegação -->
        <nav class="space-y-2">
          <a href="/app/dashboard" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 text-secondary hover:text-primary text-xs font-semibold font-apple-text transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v4a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-3-3v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            Workspace
          </a>
          <a href="/app/analista-contratos" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 text-secondary hover:text-primary text-xs font-semibold font-apple-text transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            Contratos
          </a>
          <a href="/app/copiloto-peticoes" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl bg-primary text-white text-xs font-semibold font-apple-text transition-all shadow-xs">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
            </svg>
            Petições
          </a>
          <a href="/app/auditoria-provas" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 text-secondary hover:text-primary text-xs font-semibold font-apple-text transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Provas
          </a>
        </nav>
      </div>

      <!-- Rodapé da Sidebar -->
      <div class="space-y-4">
        <div class="px-2">
          <p class="font-apple-text text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Advogado Conectado</p>
          <p class="font-apple-text text-xs text-primary truncate">advogado@empresa.com.br</p>
        </div>
        <a href="/app/auth" class="flex items-center gap-3 px-4 min-h-[44px] rounded-2xl hover:bg-red-50/60 border border-transparent hover:border-red-100 text-red-500 text-xs font-semibold font-apple-text transition-all">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          Sair
        </a>
      </div>
    </aside>

    <!-- Conteúdo Principal -->
    <main id="content" class="flex-1 flex flex-col gap-6 z-10 opacity-0 translate-y-4">
      
      <!-- Cabeçalho do Workspace -->
      <div class="bg-white border border-border rounded-[32px] apple-hardware-card p-6 flex justify-between items-center shadow-sm">
        <div>
          <span class="inline-block text-[9px] font-bold text-accent bg-accent/10 px-2.5 py-1 rounded-full uppercase tracking-wider font-apple-text mb-2">Engine 02</span>
          <h1 class="font-apple-display font-bold text-2xl tracking-[-0.04em] text-primary">Copiloto de Petições Iniciais</h1>
        </div>
        <a href="/app/dashboard" class="flex items-center gap-2 text-xs font-semibold text-secondary hover:text-primary transition-colors min-h-[44px] px-3 rounded-full hover:bg-slate-50 font-apple-text">
          ← Voltar
        </a>
      </div>

      <!-- Split View (Duas colunas de igual peso ou balanceadas) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch flex-1">
        
        <!-- Coluna Esquerda: Entrada de Fatos e Estruturação -->
        <div class="bg-white border border-border rounded-[32px] apple-hardware-card p-6 sm:p-8 flex flex-col justify-between shadow-sm">
          <div class="space-y-6">
            <h2 class="font-apple-display font-bold text-lg tracking-tight text-primary">Relato do Caso & Fatos</h2>
            
            <!-- Entrada de Texto de Fatos -->
            <div class="space-y-2">
              <label for="relato" class="block font-apple-text font-semibold text-[11px] text-primary uppercase tracking-wider">Descrição Detalhada do Evento</label>
              <textarea 
                id="relato"
                placeholder="Insira os fatos trazidos pelo cliente (ex: atraso de voo internacional causando perda de conexão de trabalho...)"
                class="w-full bg-[#F9F9FB] border border-slate-200/80 rounded-2xl p-4 text-xs font-apple-text text-primary min-h-[160px] focus:outline-hidden focus:ring-2 focus:ring-primary/10 focus:border-primary transition-all shadow-inner resize-none"
              ></textarea>
            </div>

            <!-- Seleção de Ação Jurídica -->
            <div class="space-y-3">
              <label class="block font-apple-text font-semibold text-[11px] text-primary uppercase tracking-wider">Tipo da Ação Pretendida</label>
              <select class="w-full bg-[#F9F9FB] border border-slate-200/80 rounded-xl px-4 py-3 text-xs font-apple-text text-primary focus:outline-hidden focus:ring-2 focus:ring-primary/10">
                <option>Ação Indenizatória por Danos Morais/Materiais</option>
                <option>Ação de Obrigação de Fazer c/c Tutela</option>
                <option>Ação de Rescisão Contratual</option>
              </select>
            </div>

            <!-- Inclusão de Pedido de Liminar / Tutela de Urgência -->
            <div class="flex items-center gap-3">
              <input type="checkbox" id="tutela" class="w-4 h-4 border-slate-300 rounded text-primary focus:ring-primary/10" />
              <label for="tutela" class="font-apple-text text-xs text-primary font-semibold">Incluir Pedido de Tutela de Urgência (Liminar)</label>
            </div>
          </div>

          <div class="pt-8">
            <button id="btn-gerar" data-magnetic class="w-full bg-primary text-white font-semibold text-xs min-h-[46px] flex items-center justify-center rounded-full hover:bg-slate-800 transition-all font-apple-text cursor-pointer">
              Gerar Peça Inicial
            </button>
          </div>
        </div>

        <!-- Coluna Direita: Peça Estruturada Gerada -->
        <div class="bg-white border border-border rounded-[32px] apple-hardware-card p-6 sm:p-8 flex flex-col justify-between shadow-sm relative overflow-hidden">
          <div class="space-y-6">
            <div class="flex justify-between items-center">
              <h2 class="font-apple-display font-bold text-lg tracking-tight text-primary">Peça Jurisprudencial</h2>
              <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-green-600 bg-green-50 px-2.5 py-1 rounded-full uppercase tracking-wider font-apple-text">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                Engine Pronta
              </span>
            </div>

            <!-- Estado Vazio / Tutorial Inicial -->
            <div id="result-placeholder" class="py-16 text-center space-y-4">
              <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-slate-50 border border-slate-200/40 text-slate-400">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
                </svg>
              </div>
              <div class="max-w-xs mx-auto">
                <p class="font-apple-text font-semibold text-xs text-primary">Nenhuma petição gerada</p>
                <p class="font-apple-text text-[11px] text-slate-400 mt-1">Descreva o caso e clique em gerar para compilar a petição inicial estruturada no CPC.</p>
              </div>
            </div>

            <!-- Simulação de Peça Gerada (Escondido Inicialmente) -->
            <div id="result-data" class="bg-slate-50 border border-slate-200/60 rounded-2xl p-4 text-[10px] font-mono leading-relaxed text-slate-700 max-h-[350px] overflow-y-auto hidden opacity-0 space-y-4 select-all">
              <p>EXCELENTÍSSIMO SENHOR DOUTOR JUIZ DE DIREITO DA VARA CÍVEL DA COMARCA DE [...]</p>
              
              <p><strong>REQUERENTE:</strong> [...], brasileiro, estado civil [...], profissão [...], portador da cédula de identidade RG nº [...] e inscrito no CPF sob o nº [...], residente e domiciliado [...], por seu advogado infra-assinado...</p>
              
              <p><strong>REQUERIDO:</strong> COMPANHIA AÉREA [...], pessoa jurídica de direito privado...</p>
              
              <p><strong>I. DOS FATOS</strong><br/>
              O Requerente adquiriu passagem aérea internacional para viagem de trabalho agendada para [...]. Contudo, no dia do embarque, restou surpreendido com atraso injustificado superior a 8 horas...</p>
              
              <p><strong>II. DO DIREITO</strong><br/>
              A jurisprudência pátria consolidada no C. STJ prevê a aplicação objetiva do Código de Defesa do Consumidor aos contratos de transporte de passageiros (Art. 14, CDC)...</p>
            </div>
          </div>

          <div id="result-footer" class="pt-8 border-t border-slate-100 hidden opacity-0">
            <button data-magnetic class="w-full bg-[#F9F9FB] border border-slate-200 text-primary font-semibold text-xs min-h-[44px] flex items-center justify-center rounded-full hover:bg-slate-50 transition-all font-apple-text">
              Copiar Texto da Peça
            </button>
          </div>
        </div>

      </div>
    </main>
  </div>
</RootLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Animações de Entrada
    gsap.to("#sidebar", {
      opacity: 1,
      x: 0,
      duration: 0.6,
      ease: "power2.out"
    });

    gsap.to("#content", {
      opacity: 1,
      y: 0,
      duration: 0.6,
      ease: "power2.out",
      delay: 0.1
    });

    // Simulação de Geração ao Clicar
    const btnGerar = document.getElementById("btn-gerar");
    const placeholder = document.getElementById("result-placeholder");
    const resultData = document.getElementById("result-data");
    const resultFooter = document.getElementById("result-footer");

    if (btnGerar && placeholder && resultData) {
      btnGerar.addEventListener("click", () => {
        gsap.to(placeholder, {
          opacity: 0,
          y: -10,
          duration: 0.3,
          onComplete: () => {
            placeholder.classList.add("hidden");
            resultData.classList.remove("hidden");
            resultFooter.classList.remove("hidden");
            
            gsap.to(resultData, {
              opacity: 1,
              duration: 0.5,
              ease: "power2.out"
            });
            gsap.to(resultFooter, {
              opacity: 1,
              duration: 0.5,
              ease: "power2.out"
            });
          }
        });
      });
    }

    // Efeito Magnético
    document.querySelectorAll('[data-magnetic]').forEach(btn => {
      btn.addEventListener('mousemove', e => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        gsap.to(btn, {
          x: x * 0.25,
          y: y * 0.25,
          duration: 0.4,
          ease: 'power2.out'
        });
      });
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, { x: 0, y: 0, duration: 0.5, ease: 'elastic.out(1, 0.5)' });
      });
    });
  });
</script>
